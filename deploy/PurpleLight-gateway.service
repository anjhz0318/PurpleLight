[Unit]
Description=PurpleLight - Feishu WS & Multi-Agent Orchestration Gateway
After=network.target PurpleLight-opencode.service

[Service]
Type=simple
WorkingDirectory=/root/PurpleLight
EnvironmentFile=-/root/PurpleLight/.env
ExecStart=/root/.bun/bin/bun run /root/PurpleLight/src/gateway.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
