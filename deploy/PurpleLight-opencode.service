[Unit]
Description=PurpleLight - OpenCode Headless Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/PurpleLight
EnvironmentFile=-/root/PurpleLight/.env
ExecStart=/usr/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
