{
  "$schema": "https://opencode.ai/config.json",
  "model": "glm/glm-5.3",
  "small_model": "deepseek/deepseek-flash",
  "plugin": [
    "./plugin/PurpleLight-plugin.ts"
  ],
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "external_directory": "allow",
    "webfetch": "allow"
  },
  "agent": {
    "strategist": {
      "mode": "primary",
      "model": "glm/glm-5.3",
      "description": "PurpleLight Strategist Microkernel (pure high-level reasoning, strategist skills, insight management & scout orchestration)",
      "tools": {
        "bash": false,
        "read": false,
        "write": false,
        "edit": false,
        "grep": false,
        "glob": false,
        "webfetch": false,
        "websearch": false,
        "skill": false,
        "task": false,
        "apply_patch": false,
        "todowrite": false,
        "question": false,
        "load_skill": true,
        "graph_overview": true,
        "search_history": true,
        "load_history": true,
        "manage_insight": true,
        "delete_record": true,
        "record_fact": true,
        "report_finding": true,
        "fork_scout": true,
        "stop_scout": true,
        "send_hint": true,
        "broadcast_hint": true,
        "extend_scout": true,
        "list_scouts": true,
        "get_scout_detail": true,
        "clean_workspaces": true,
        "submit_scout_report": false
      }
    },
    "scout": {
      "mode": "all",
      "model": "deepseek/deepseek-flash",
      "maxSteps": 80,
      "description": "PurpleLight Scout Executor (full code/bash/scout-skill/MCP capabilities with incremental fact/finding reporting)",
      "tools": {
        "bash": true,
        "read": true,
        "write": true,
        "edit": true,
        "grep": true,
        "glob": true,
        "webfetch": true,
        "websearch": true,
        "skill": true,
        "load_skill": true,
        "apply_patch": true,
        "todowrite": true,
        "task": false,
        "question": false,
        "graph_overview": true,
        "record_fact": true,
        "report_finding": true,
        "submit_scout_report": true,
        "search_history": false,
        "load_history": false,
        "manage_insight": false,
        "delete_record": false,
        "fork_scout": false,
        "stop_scout": false,
        "send_hint": false,
        "broadcast_hint": false,
        "extend_scout": false,
        "list_scouts": false,
        "get_scout_detail": false,
        "clean_workspaces": false
      }
    }
  },
  "provider": {
    "glm": {
      "name": "Zhipu GLM (BigModel)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://open.bigmodel.cn/api/paas/v4",
        "apiKey": "{env:GLM_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "glm-5.3",
          "reasoning": true,
          "tool_call": true
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "reasoning": true,
          "tool_call": true
        },
        "glm-5.3-flashx": {
          "name": "glm-5.3-flashx",
          "reasoning": true,
          "tool_call": true
        },
        "glm-5.3-flashx-legal": {
          "name": "glm-5.3-flashx-legal",
          "reasoning": true,
          "tool_call": true
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "reasoning": true,
          "tool_call": true
        },
        "glm-5.1": {
          "name": "glm-5.1",
          "reasoning": true,
          "tool_call": true
        },
        "glm-5": {
          "name": "glm-5",
          "reasoning": true,
          "tool_call": true
        },
        "glm-5-turbo": {
          "name": "glm-5-turbo",
          "reasoning": true,
          "tool_call": true
        },
        "glm-4.7": {
          "name": "glm-4.7",
          "reasoning": true,
          "tool_call": true
        },
        "glm-4.6": {
          "name": "glm-4.6",
          "reasoning": true,
          "tool_call": true
        },
        "glm-4.5": {
          "name": "glm-4.5",
          "reasoning": true,
          "tool_call": true
        },
        "glm-4.5-air": {
          "name": "glm-4.5-air",
          "reasoning": true,
          "tool_call": true
        }
      }
    },
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "custom": {
      "name": "Custom OpenAI-Compatible",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:CUSTOM_BASE_URL}",
        "apiKey": "{env:CUSTOM_API_KEY}"
      },
      "models": {}
    }
  }
}
