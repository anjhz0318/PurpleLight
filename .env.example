# Model Provider API Keys (glm / deepseek / openrouter / custom)
GLM_API_KEY=your_zhipu_glm_api_key_here
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional Custom OpenAI-Compatible Endpoint (configurable dynamically via /provider set custom)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Feishu (Lark) Self-Built App Credentials (WebSocket Long-Connection Mode)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Gateway Tuning
OPENCODE_URL=http://127.0.0.1:4096
PURPLELIGHT_PORT=4099
PURPLELIGHT_HEARTBEAT_MS=60000

# Auto-reload the local opencode backend after /provider set rewrites .env.
# PURPLELIGHT_OPENCODE_RESTART_CMD="systemctl restart PurpleLight-opencode.service"
# PURPLELIGHT_SKIP_OPENCODE_RESTART=0
